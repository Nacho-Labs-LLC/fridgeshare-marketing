---
const cols = [
  [
    { label: 'Shared editing',        body: 'The full board URL contains a #token fragment. Anyone with it can edit; anyone without it sees the board read-only.' },
    { label: 'Named boards',          body: 'Boards live at /b/kitchen-board style URLs — bookmarkable, human-readable, permanent.' },
    { label: 'Admin token',           body: 'Set SELFHOST_ADMIN_TOKEN before going public. Without it, anyone who reaches the server can create or delete boards.' },
    { label: 'Image uploads',         body: 'Photos are stored on disk as immutable assets referenced by opaque IDs. Board JSON stays small.' },
  ],
  [
    { label: 'Zero npm dependencies', body: 'The server has no production npm dependencies. Node 20+ and a filesystem is all it needs to run.' },
    { label: 'Rate limiting',         body: 'Write operations are rate-limited per client per board. Configurable for busier setups.' },
    { label: 'Local mode',            body: 'The /local route runs a browser-only board backed by localStorage — useful for single-device use.' },
    { label: 'Unraid community app',  body: 'Listed in the Unraid Community Applications store for one-click NAS installs.' },
  ],
];
---
<section class="border-b border-rule px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-subtle">Technical notes</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Small surface. Explicit behavior.
      </h2>
    </div>

    <div class="grid gap-x-16 lg:grid-cols-2">
      {cols.map((col) => (
        <dl class="divide-y divide-rule">
          {col.map((item) => (
            <div class="py-5">
              <dt class="text-sm font-semibold text-ink">{item.label}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-mid">{item.body}</dd>
            </div>
          ))}
        </dl>
      ))}
    </div>
  </div>
</section>
