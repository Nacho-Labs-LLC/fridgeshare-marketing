---
const left = [
  { label: 'Shared editing', body: 'The full board URL includes a #token fragment. Anyone with it can edit. Anyone without it can only view.' },
  { label: 'Named boards', body: 'Boards live at /b/kitchen-board style URLs — bookmarkable, human-readable, permanent.' },
  { label: 'Admin token', body: 'Set SELFHOST_ADMIN_TOKEN before going public. Without it, anyone who reaches the server can create or delete boards.' },
  { label: 'Image uploads', body: 'Photos are stored on disk as immutable assets, referenced by opaque IDs. The board JSON stays small.' },
];

const right = [
  { label: 'Rate limiting', body: 'Write operations are rate-limited per client per board. Configurable if your use case demands it.' },
  { label: 'Zero npm dependencies', body: 'The server has no production npm dependencies. Node 20+ and a filesystem is all it needs.' },
  { label: 'Local mode', body: 'The /local route runs a browser-only board backed by localStorage — useful for single-device testing.' },
  { label: 'Unraid community app', body: 'Listed in the Unraid Community Applications store for one-click NAS installs.' },
];
---
<section class="border-t border-rule px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted">Technical notes</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">
        Small surface. <em class="text-sage-600">Explicit behavior.</em>
      </h2>
    </div>

    <div class="grid gap-x-16 gap-y-0 lg:grid-cols-2">
      <dl class="divide-y divide-rule">
        {left.map((item) => (
          <div class="py-6">
            <dt class="text-sm font-semibold uppercase tracking-wide text-ink">{item.label}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{item.body}</dd>
          </div>
        ))}
      </dl>
      <dl class="divide-y divide-rule border-t border-rule lg:border-t-0">
        {right.map((item) => (
          <div class="py-6">
            <dt class="text-sm font-semibold uppercase tracking-wide text-ink">{item.label}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{item.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
