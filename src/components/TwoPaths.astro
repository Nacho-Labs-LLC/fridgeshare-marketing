---
---
<section id="self-host" class="border-t border-rule px-6 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-16 lg:grid-cols-[auto_1fr] lg:items-start">

      <!-- Label column -->
      <div class="lg:pt-1 lg:w-64">
        <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted">Get started</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink">
          Two commands.<br/>
          <em class="text-sage-600">Running board.</em>
        </h2>
        <p class="mt-5 text-sm leading-relaxed text-muted">
          Docker Compose is the recommended path. Downloads the image, mounts a data volume, starts on port 4173.
        </p>
        <div class="mt-8 space-y-3">
          <a
            href="https://github.com/nacho-labs-llc/fridgeshare/blob/master/docs/SELF_HOSTING.md"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm font-medium text-sage-600 hover:text-sage-700 transition-colors"
          >
            <span>Full self-hosting guide</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="https://github.com/nacho-labs-llc/fridgeshare"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm font-medium text-muted hover:text-ink transition-colors"
          >
            <span>View on GitHub</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Terminal -->
      <div>
        <div class="overflow-hidden rounded-xl border border-rule bg-ink shadow-[0_24px_60px_rgba(26,23,20,0.12)]">
          <!-- Window chrome -->
          <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3.5">
            <span class="h-3 w-3 rounded-full bg-white/10"></span>
            <span class="h-3 w-3 rounded-full bg-white/10"></span>
            <span class="h-3 w-3 rounded-full bg-white/10"></span>
            <span class="ml-2 font-mono text-xs text-white/30">bash</span>
          </div>

          <div class="p-6 font-mono text-sm leading-7">
            <p class="text-white/30"># download the compose file</p>
            <p>
              <span class="text-sage-100 opacity-70">$</span>
              <span class="text-white ml-2">curl -fsSL https://raw.githubusercontent.com/nacho-labs-llc/<wbr/>fridgeshare/main/docker-compose.yml -o docker-compose.yml</span>
            </p>
            <p class="mt-2">
              <span class="text-sage-100 opacity-70">$</span>
              <span class="text-white ml-2">docker compose up -d</span>
            </p>

            <div class="mt-6 border-t border-white/10 pt-5">
              <p class="text-white/30"># open the board directory</p>
              <p>
                <span class="text-sage-100 opacity-70">$</span>
                <span class="text-white ml-2">open http://localhost:4173</span>
              </p>
            </div>

            <div class="mt-6 border-t border-white/10 pt-5 text-xs">
              <p class="text-white/30"># before putting it on the internet, set an admin token</p>
              <p>
                <span class="text-sage-100 opacity-70">$</span>
                <span class="text-white/60 ml-2">cat ./data/.admin-token</span>
                <span class="text-white/30 ml-2"># auto-generated on first start</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Docker single-run alt -->
        <div class="mt-4 rounded-lg border border-rule bg-parchment px-5 py-4">
          <p class="font-mono text-xs text-muted uppercase tracking-widest mb-3">or a single docker run</p>
          <code class="font-mono text-xs text-ink leading-6 break-all">
            docker run -d -p 4173:4173 -v "$(pwd)/data:/app/server/data" --restart unless-stopped nacholabs/fridgeshare
          </code>
        </div>
      </div>
    </div>
  </div>
</section>
