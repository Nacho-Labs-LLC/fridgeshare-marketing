---
---
<section id="self-host" class="border-b border-rule bg-night px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/40">Get started</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Run it with Docker Compose.
      </h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-white/60">
        Docker Compose is the recommended path. Downloads the image, mounts a data volume at <code class="font-mono text-sm text-white/80">./data</code>, starts on port 4173.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1fr_340px]">
      <!-- Terminal -->
      <div class="rounded-xl border border-white/10 bg-white/5 overflow-hidden">
        <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-white/10"></span>
          <span class="ml-2 font-mono text-xs text-white/30">bash</span>
        </div>
        <div class="p-5 font-mono text-sm space-y-1 leading-7">
          <p class="text-white/30"># download the compose file</p>
          <p><span class="text-pine-600">$</span> <span class="text-white">curl -fsSL https://raw.githubusercontent.com/nacho-labs-llc/fridgeshare/main/docker-compose.yml -o docker-compose.yml</span></p>
          <p><span class="text-pine-600">$</span> <span class="text-white">docker compose up -d</span></p>
          <div class="pt-3 border-t border-white/10 mt-3">
            <p class="text-white/30"># board directory at http://localhost:4173</p>
          </div>
        </div>
      </div>

      <!-- Sidebar notes -->
      <div class="space-y-4">
        <div class="rounded-xl border border-white/10 bg-white/5 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-white/40">Single docker run</p>
          <code class="mt-3 block font-mono text-xs text-white/70 leading-6 break-all">
            docker run -d \<br/>
            &nbsp;&nbsp;-p 4173:4173 \<br/>
            &nbsp;&nbsp;-v "$(pwd)/data:/app/server/data" \<br/>
            &nbsp;&nbsp;--restart unless-stopped \<br/>
            &nbsp;&nbsp;nacholabs/fridgeshare
          </code>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/5 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-white/40">Admin token</p>
          <p class="mt-2 text-sm text-white/60 leading-relaxed">
            Generated automatically on first start. Retrieve it any time:
          </p>
          <code class="mt-2 block font-mono text-xs text-white/70">cat ./data/.admin-token</code>
        </div>

        <div class="flex gap-4 pt-2">
          <a href="https://github.com/nacho-labs-llc/fridgeshare/blob/master/docs/SELF_HOSTING.md" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-pine-700 hover:text-pine-600 transition-colors">Self-hosting guide →</a>
          <a href="https://github.com/nacho-labs-llc/fridgeshare" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-white/40 hover:text-white/70 transition-colors">GitHub ↗</a>
        </div>
      </div>
    </div>
  </div>
</section>
