---
const items = [
  { emoji: '🔤', label: 'Letter magnets',  desc: 'Alphabet tiles with color presets and size controls' },
  { emoji: '📝', label: 'Sticky notes',    desc: 'Text notes with paper styles and custom colors' },
  { emoji: '📸', label: 'Photos',          desc: 'Upload images with optional captions and frame styles' },
  { emoji: '😀', label: 'Emoji magnets',   desc: 'Large emoji tiles for quick reactions and decoration' },
  { emoji: '✏️', label: 'Drawings',        desc: 'Dry-erase style sketches directly on the board' },
  { emoji: '🎨', label: 'Themes',          desc: 'Swap the fridge surface between curated styles' },
];
---
<section class="border-b border-rule px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-subtle">What goes on a board</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Six types of items — all yours.
      </h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div class="flex gap-4 rounded-xl border border-rule bg-surface p-5">
          <span class="text-xl leading-none mt-0.5 flex-shrink-0">{item.emoji}</span>
          <div>
            <h3 class="text-sm font-semibold text-ink">{item.label}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-mid">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-6 text-sm text-subtle">
      Every item is stored as plain JSON in <code class="font-mono text-xs text-ink">server/data/fridges/&lt;slug&gt;.json</code> — readable, backupable, no proprietary format.
    </p>
  </div>
</section>
