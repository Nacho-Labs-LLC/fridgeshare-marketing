---
const items = [
  { emoji: '🔤', label: 'Letter magnets', desc: 'Alphabet tiles with color presets and size controls' },
  { emoji: '📝', label: 'Sticky notes', desc: 'Text notes with paper styles and custom colors' },
  { emoji: '📸', label: 'Photos', desc: 'Upload images with optional captions and frame styles' },
  { emoji: '😀', label: 'Emoji magnets', desc: 'Large emoji tiles for quick reactions and decoration' },
  { emoji: '✏️', label: 'Drawings', desc: 'Dry-erase style sketches directly on the board' },
  { emoji: '🎨', label: 'Themes', desc: 'Swap the fridge surface between curated styles' },
];
---
<section id="preview" class="border-t border-rule bg-white px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 flex items-end justify-between gap-8 border-b border-rule pb-6">
      <h2 class="font-display text-3xl font-semibold text-ink sm:text-4xl">
        What goes on a board
      </h2>
      <p class="hidden max-w-xs text-sm leading-relaxed text-muted sm:block">
        Six types of items — all movable, all persistent, all living on your hardware.
      </p>
    </div>

    <div class="grid gap-px bg-rule sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item, i) => (
        <div class="group flex gap-5 bg-white p-7 transition-colors hover:bg-sage-50">
          <div class="mt-0.5 flex-shrink-0 text-2xl leading-none">{item.emoji}</div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-ink">{item.label}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-px bg-rule">
      <div class="bg-white px-7 py-5">
        <p class="text-sm text-muted">
          Every item is stored as plain JSON. Board state lives in <code class="font-mono text-xs text-ink">server/data/fridges/&lt;slug&gt;.json</code> — readable, backupable, and not locked in a proprietary format.
        </p>
      </div>
    </div>
  </div>
</section>
