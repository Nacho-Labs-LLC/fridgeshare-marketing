<footer class="border-t border-rule bg-ink px-6 py-12">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <a href="#top" class="font-display text-base font-semibold italic text-white hover:text-sage-100 transition-colors">
        FridgeShare
      </a>
      <p class="mt-2 max-w-xs text-xs leading-relaxed text-white opacity-40">
        A self-hosted household board. MIT licensed. Built by Nacho Labs LLC.
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3">
      {[
        { label: 'Self-hosting guide', href: 'https://github.com/nacho-labs-llc/fridgeshare/blob/master/docs/SELF_HOSTING.md' },
        { label: 'Architecture', href: 'https://github.com/nacho-labs-llc/fridgeshare/blob/master/docs/ARCHITECTURE.md' },
        { label: 'GitHub', href: 'https://github.com/nacho-labs-llc/fridgeshare' },
